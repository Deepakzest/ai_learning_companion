{
    "manifest_version": 3,
    "name": "AI Learning Companion",
    "version": "1.0.0",
    "description": "AI-powered learning companion for YouTube videos.",

    "action": {
        "default_popup": "popup.html"
    },

    "permissions": [],

    "host_permissions": [
        "https://www.youtube.com/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}